# Chuoi ket noi khong nam o day: docker-compose tu ghep tu ba bien duoi.
POSTGRES_USER=pricing
POSTGRES_PASSWORD=
POSTGRES_DB=pricing
POSTGRES_PORT=5433
API_PORT=8100
TZ=Asia/Bangkok

# Ky token dang nhap. Toi thieu 16 ky tu. Doi chuoi nay = dang xuat tat ca.
AUTH_SECRET=

# Tai khoan dau tien, chi doc khi bang users con rong.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Administrator

# Dang nhap bang gi: local (bang users rieng) hoac pacos (tai khoan PacOs).
AUTH_MODE=local
# Dia chi PacOs khi AUTH_MODE=pacos, vi du https://pantongone.com
PACOS_URL=
# Khoa chung voi PacOs (cung gia tri PANTONGONE_BRIDGE_KEY ben PacOs), >= 32 ky tu.
PACOS_BRIDGE_KEY=
